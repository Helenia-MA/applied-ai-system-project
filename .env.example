# TEMPLATE ONLY — never put a real key in this file. It gets committed to git.
# Your key belongs in .env, which is gitignored:
#
#   cp .env.example .env     # then edit .env, not this file

# Required for AI care suggestions. Get a free key from https://aistudio.google.com/
# (AI Studio -> Get API key). The app still runs without it — suggestions are
# simply disabled and the scheduler works as normal.
GEMINI_API_KEY=

# Optional. Set to 0 to run the app with suggestions switched off even when a
# key is present (useful for demos and for graders without a key).
USE_LLM=1

# Optional. Defaults to gemini-3.6-flash. Google retires models fairly often, so
# if you get "isn't available to this key", try the always-current alias instead:
# PAWPAL_MODEL=gemini-flash-latest
